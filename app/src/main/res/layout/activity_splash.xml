<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#12203A"
    android:padding="24dp">

    <!-- Frame Lingkaran Putih untuk Logo -->
    <androidx.cardview.widget.CardView
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:cardCornerRadius="70dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF">

        <ImageView
            android:id="@+id/imgSplashLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:src="@drawable/logosawit"
            android:scaleType="fitCenter" />

    </androidx.cardview.widget.CardView>

    <!-- Teks Utama SawitMON -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="SawitMON"
        android:textColor="#F5A524"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Tagline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="pantau kebun dari genggaman"
        android:textColor="#E5E7EB"
        android:textSize="15sp" />

</LinearLayout>