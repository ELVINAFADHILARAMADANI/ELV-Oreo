<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Riwayat"
        android:textColor="#0F172A"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="Semua catatan perawatan kebun"
        android:textColor="#64748B"
        android:textSize="13sp" />

    <!-- Kolom Pencarian -->
    <EditText
        android:id="@+id/etCariRiwayat"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_card_grid"
        android:hint="Cari blok atau catatan..."
        android:paddingHorizontal="14dp"
        android:textColor="#0F172A"
        android:textColorHint="#94A3B8"
        android:textSize="13sp" />

    <!-- Filter Kategori (Semua, Pupuk, Siram, Panen) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFilterSemua"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#12203A"
            android:padding="0dp"
            android:text="Semua"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFilterPupuk"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#E2E8F0"
            android:padding="0dp"
            android:text="Pupuk"
            android:textAllCaps="false"
            android:textColor="#334155"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFilterSiram"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#E2E8F0"
            android:padding="0dp"
            android:text="Siram"
            android:textAllCaps="false"
            android:textColor="#334155"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnFilterPanen"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:backgroundTint="#E2E8F0"
            android:padding="0dp"
            android:text="Panen"
            android:textAllCaps="false"
            android:textColor="#334155"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Label Periode -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Periode"
        android:textColor="#64748B"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_card_grid"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:text="November 2026"
        android:textColor="#0F172A"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- RecyclerView Daftar Riwayat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRiwayat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>